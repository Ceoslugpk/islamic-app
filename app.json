{
  "expo": {
    "name": "Islamic - Your Daily Companion",
    "slug": "islamic",
    "version": "1.0.0",
    "scheme": "salah",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon-ink.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAF9",
      "dark": {
        "image": "./assets/splash-icon.png",
        "backgroundColor": "#0E1214"
      }
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.qashi.islamic",
      "adaptiveIcon": {
        "backgroundColor": "#0F5A4A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/adhan_chime.wav"
          ],
          "androidMode": "default",
          "androidPermissions": [
            "RECEIVE_BOOT_COMPLETED",
            "SCHEDULE_EXACT_ALARM",
            "USE_EXACT_ALARM"
          ]
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Location is used to calculate prayer times, Qibla direction, and find nearby mosques."
        }
      ],
      "expo-splash-screen",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-background-fetch",
      "expo-task-manager",
      "expo-video",
      "expo-sharing"
    ]
  }
}